{
  "version": 1,
  "description": "CCS 全局配置 — session-launcher 的中央配置中心",
  "auto_send": {
    "enabled": true,
    "interval_sec": 2.0,
    "messages": {
      "default": [],
      "roles": {
        "dkk": [
          "检查 feed listener 健康状态",
          "加载待处理 task_spec"
        ],
        "pg": [
          "读 project_manual.md 更新",
          "检查队列里有没有 task_spec"
        ],
        "coordinator": [
          "汇总各角色进度",
          "检查是否有死锁探测器触发"
        ],
        "ssk": [
          "审计当前所有 CCS 哨兵",
          "检查 bus 轮次超时",
          "写本周安全快照"
        ],
        "engineer": [
          "加载待处理 task_spec 并执行",
          "检查 TASKS.md 开始下一个任务"
        ],
        "reviewer": [
          "加载待处理 task_spec 并审查",
          "检查积压代码审查任务"
        ],
        "qa": [
          "加载待处理 task_spec 并测试",
          "检查待执行测试任务"
        ],
        "writer": [
          "加载待处理 task_spec 并文档",
          "检查待写文档任务"
        ],
        "closer": [
          "加载待处理 task_spec 并闭环",
          "检查待闭环工作流"
        ],
        "scout": [
          "加载待处理 task_spec 并侦察",
          "检查待调研任务"
        ],
        "product_architect": [
          "加载待处理 task_spec 并架构设计",
          "检查待架构任务"
        ],
        "maintainer": [
          "加载待处理 task_spec 并运维",
          "检查待运维任务"
        ],
        "curator": [
          "加载待处理 task_spec 并管理知识",
          "检查知识管理任务"
        ]
      }
    }
  },
  "routing": {
    "default_policy": "sticky",
    "overrides": {}
  },
  "defaults": {
    "drive": "ondemand",
    "bus_timeout": 300,
    "bus_track": "",
    "feed_cat": ""
  }
}
